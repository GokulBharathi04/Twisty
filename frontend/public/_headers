# Cloudflare Pages response headers (static files only; /api/* sets its own).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CRA puts a content hash in every file name under /static, so these never change.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos here keep the same name when replaced, so browsers must check for a newer copy (a cheap 304 when unchanged).
/img/*
  Cache-Control: public, max-age=0, must-revalidate
